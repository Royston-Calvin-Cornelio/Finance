import pandas as pd

# ---------------------------------------
# 1. Load Data
# ---------------------------------------

file_path = "../data/financial_transactions.csv"

df = pd.read_csv(file_path)

print("Dataset loaded successfully")
print("Number of rows:", len(df))
print("Number of columns:", len(df.columns))


# ---------------------------------------
# 2. Data Cleaning
# ---------------------------------------

# Remove duplicate records
df = df.drop_duplicates()

# Convert TransactionDate to date format
df["TransactionDate"] = pd.to_datetime(
    df["TransactionDate"],
    errors="coerce"
)

# Convert TransactionAmount to numeric
df["TransactionAmount"] = pd.to_numeric(
    df["TransactionAmount"],
    errors="coerce"
)

# Remove rows where important fields are missing
df = df.dropna(
    subset=["ContractID", "TransactionAmount"]
)

print("\nData cleaning completed")
print("Rows after cleaning:", len(df))


# ---------------------------------------
# 3. Basic Financial Analysis
# ---------------------------------------

total_transactions = len(df)

total_amount = df["TransactionAmount"].sum()

average_transaction = df["TransactionAmount"].mean()

maximum_transaction = df["TransactionAmount"].max()

minimum_transaction = df["TransactionAmount"].min()

print("\nFinancial Summary")
print("-------------------------")
print("Total Transactions:", total_transactions)
print("Total Transaction Amount:", total_amount)
print("Average Transaction:", average_transaction)
print("Maximum Transaction:", maximum_transaction)
print("Minimum Transaction:", minimum_transaction)


# ---------------------------------------
# 4. Transaction Code Analysis
# ---------------------------------------

transaction_summary = (
    df.groupby("TransactionCode")
      .agg(
          Transaction_Count=("TransactionAmount", "count"),
          Total_Amount=("TransactionAmount", "sum"),
          Average_Amount=("TransactionAmount", "mean")
      )
      .reset_index()
)

print("\nTransaction Code Summary")
print(transaction_summary)


# ---------------------------------------
# 5. Monthly Analysis
# ---------------------------------------

df["Month"] = df["TransactionDate"].dt.to_period("M")

monthly_summary = (
    df.groupby("Month")
      .agg(
          Transaction_Count=("TransactionAmount", "count"),
          Total_Amount=("TransactionAmount", "sum")
      )
      .reset_index()
)

print("\nMonthly Summary")
print(monthly_summary)


# ---------------------------------------
# 6. Identify Large Transactions
# ---------------------------------------

large_transactions = df[
    df["TransactionAmount"] > 100000
]

print("\nLarge Transactions")
print(large_transactions)


# ---------------------------------------
# 7. Contract-Level Analysis
# ---------------------------------------

contract_summary = (
    df.groupby("ContractID")
      .agg(
          Transaction_Count=("TransactionAmount", "count"),
          Total_Amount=("TransactionAmount", "sum")
      )
      .reset_index()
      .sort_values(
          "Total_Amount",
          ascending=False
      )
)

print("\nTop Contracts by Transaction Amount")
print(contract_summary.head(10))


# ---------------------------------------
# 8. Export Results
# ---------------------------------------

contract_summary.to_csv(
    "../output/contract_summary.csv",
    index=False
)

transaction_summary.to_csv(
    "../output/transaction_summary.csv",
    index=False
)

monthly_summary.to_csv(
    "../output/monthly_summary.csv",
    index=False
)

print("\nAnalysis completed successfully.")
print("Results exported to output folder.")
