import pandas as pd

# ============================================================
# LOAD DATA
# ============================================================

file_path = "financial_transactions.csv"

df = pd.read_csv(file_path)

print("FINANCIAL DATA ANALYSIS")
print("=" * 50)

print("Total Records:", len(df))
print("Total Columns:", len(df.columns))

print("\nColumns:")
print(df.columns.tolist())


# ============================================================
# CONVERT COLUMNS
# ============================================================

df["TransactionDate"] = pd.to_datetime(
    df["TransactionDate"],
    errors="coerce"
)

df["TransactionAmount"] = pd.to_numeric(
    df["TransactionAmount"],
    errors="coerce"
)


# ============================================================
# BUSINESS TYPE
# ============================================================

df["BusinessType"] = df["TransactionCode"].apply(
    lambda x: "Group" if x == "Group Premium" else "Individual"
)


# ============================================================
# DATA QUALITY
# ============================================================

print("\nDATA QUALITY")
print("=" * 50)

print("Duplicate Records:", df.duplicated().sum())

print("\nMissing Values:")
print(df.isnull().sum())


# ============================================================
# FINANCIAL SUMMARY
# ============================================================

print("\nFINANCIAL SUMMARY")
print("=" * 50)

print(
    "Total Transaction Amount:",
    df["TransactionAmount"].sum()
)

print(
    "Average Transaction Amount:",
    df["TransactionAmount"].mean()
)

print(
    "Maximum Transaction Amount:",
    df["TransactionAmount"].max()
)

print(
    "Minimum Transaction Amount:",
    df["TransactionAmount"].min()
)


# ============================================================
# TRANSACTION ANALYSIS
# ============================================================

print("\nTRANSACTION ANALYSIS")
print("=" * 50)

transaction_analysis = df.groupby("TransactionCode")[
    "TransactionAmount"
].agg(
    Transaction_Count="count",
    Total_Amount="sum",
    Average_Amount="mean"
)

print(transaction_analysis)


# ============================================================
# BUSINESS TYPE ANALYSIS
# ============================================================

print("\nBUSINESS TYPE ANALYSIS")
print("=" * 50)

business_analysis = df.groupby("BusinessType")[
    "TransactionAmount"
].agg(
    Transaction_Count="count",
    Total_Amount="sum",
    Average_Amount="mean"
)

print(business_analysis)


# ============================================================
# MONTHLY ANALYSIS
# ============================================================

print("\nMONTHLY ANALYSIS")
print("=" * 50)

df["Month"] = df["TransactionDate"].dt.to_period("M")

monthly_analysis = df.groupby("Month")[
    "TransactionAmount"
].agg(
    Transaction_Count="count",
    Total_Amount="sum"
)

print(monthly_analysis)


# ============================================================
# LARGE TRANSACTIONS
# ============================================================

print("\nLARGE TRANSACTIONS")
print("=" * 50)

large_transactions = df[
    df["TransactionAmount"] > 400000
]

print(
    "Transactions above 400,000:",
    len(large_transactions)
)


# ============================================================
# GROUP PREMIUM LIFE INDICATOR
# ============================================================

print("\nGROUP PREMIUM LIFE INDICATOR")
print("=" * 50)


# Only Group Premium transactions
group_df = df[
    df["TransactionCode"] == "Group Premium"
].copy()


# Extract LifeIndicator from ContractID
def get_life_indicator(contract_id):

    contract_id = str(contract_id).strip()

    if contract_id.endswith("S1"):
        return "S1"

    elif contract_id.endswith("S"):
        return "S"

    elif contract_id.endswith("P"):
        return "P"

    else:
        return "Unknown"


group_df["LifeIndicator"] = group_df[
    "ContractID"
].apply(get_life_indicator)


print(
    group_df["LifeIndicator"].value_counts()
)


# ============================================================
# GROUP PREMIUM LIFE INDICATOR + AMOUNT
# ============================================================

print("\nGROUP PREMIUM ANALYSIS BY LIFE INDICATOR")
print("=" * 50)

life_analysis = group_df.groupby("LifeIndicator")[
    "TransactionAmount"
].agg(
    Transaction_Count="count",
    Total_Amount="sum",
    Average_Amount="mean"
)

print(life_analysis)


# ============================================================
# CHECK CONTRACT ID FORMAT
# ============================================================

print("\nGROUP PREMIUM CONTRACT ID FORMAT CHECK")
print("=" * 50)


def check_group_contract_id(contract_id):

    contract_id = str(contract_id).strip()

    # P = 11 characters
    # S = 11 characters
    # S1 = 12 characters

    if len(contract_id) in [11, 12]:
        return True

    return False


group_df["ValidContractID"] = group_df[
    "ContractID"
].apply(check_group_contract_id)


print(
    "Valid Contract IDs:",
    group_df["ValidContractID"].sum()
)

print(
    "Invalid Contract IDs:",
    (~group_df["ValidContractID"]).sum()
)


# ============================================================
# FINAL
# ============================================================

print("\nAnalysis completed successfully.")